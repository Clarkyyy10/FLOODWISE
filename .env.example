# Copy to .env.local and fill in. .env.local is git-ignored.
# Server-side only — never prefix with NEXT_PUBLIC_ (that would leak to the browser).

# Google Gemini API key (https://aistudio.google.com/app/apikey). Keys usually start with "AIza".
GEMINI_API_KEY=

# Optional: override the model. Defaults to gemini-flash-lite-latest (fast, low-latency).
GEMINI_MODEL=gemini-flash-lite-latest
