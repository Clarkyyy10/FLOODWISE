# Copy to .env.local and fill in. .env.local is git-ignored.
# Server-side only — never prefix with NEXT_PUBLIC_ (that would leak to the browser).

# Google Gemini API key (https://aistudio.google.com/app/apikey). Keys usually start with "AIza".
GEMINI_API_KEY=

# Optional: override the model. Defaults to gemini-flash-lite-latest (fast, low-latency).
GEMINI_MODEL=gemini-flash-lite-latest

# --- Google reCAPTCHA v2 (CAPTCHA / anti-bot) -------------------------------
# Create keys ("I'm not a robot" Checkbox, reCAPTCHA v2) at:
#   https://www.google.com/recaptcha/admin/create
# Add your domains (e.g. localhost and your LAN IP) as allowed hostnames.
# The SITE key is public by design and safe to expose to the browser.
# The SECRET key is server-only — never commit a real one or prefix it with NEXT_PUBLIC_.
# If these are left empty, the app falls back to Google's official TEST keys,
# which ALWAYS PASS (and show a "for testing only" notice). Replace them to get
# the real image challenge in production.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
